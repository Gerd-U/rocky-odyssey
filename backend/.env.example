# Copia este archivo como backend/.env para desarrollo local (backend/.env no se sube a git).

# Orígenes que pueden llamar a la API (CORS), separados por comas y sin "/" final.
# En producción: la URL del frontend en Vercel, p. ej. https://rocky-odyssey.vercel.app
ORIGENES=http://localhost:5173

# Opcional. Carpeta con sources_log_moon.csv y sources_log_mars.csv (temperaturas de las bases).
# Si no se define, se usa backend/data, donde generar_datos_web.py los copia. En Vercel no hace falta.
# DATOS_DIR=data
